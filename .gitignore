# 의존성
node_modules/

# 빌드 결과물
dist/
dist-ssr/
*.tsbuildinfo

# 방명록 sqlite 데이터
data/
*.db
*.db-shm
*.db-wal

# 환경변수 (예시 파일만 커밋)
.env
.env.*
!.env.example

# 로그
*.log
npm-debug.log*

# OS / 에디터
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json

# iCloud 동기화 폴더에서 작업할 때 동기화 제외용 (.nosync)
*.nosync/
web/node_modules

# iCloud 동기화 폴더에서 작업할 때 동기화 제외용 (.nosync 심볼릭 링크)
node_modules
*.nosync

# Gemini 원본 시트(장당 5~8MB) — 앱에는 art/gemini/build.py 가 만든 축소 아틀라스만 들어간다
art/gemini/*.png

# 스타일 참고용으로 받은 타사 게임 이미지 — 저장소에 올리지 않는다
art/refs/

# 오픈 라이선스 원본 도트(art/cabbit/raw/data/…)는 빌드 스크립트가 다시 받지 못하므로 저장소에 둔다
# (위의 "data/" 규칙에 걸리지 않게 예외로 둔다)
!art/cabbit/raw/data/

# 파이썬 빌드 스크립트 캐시
__pycache__/
