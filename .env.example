# docker compose 설정 예시. 이 파일을 .env 로 복사해서 값을 채운다.
#   cp .env.example .env

# ===== web (nginx) =====
# 웹을 노출할 호스트 포트
WEB_PORT=8080

# ----- web 빌드 인자 (이미지 빌드 시점에 Vite 에 주입) -----
# 서빙 하위 경로. 자체 도메인/도커는 "/", GitHub Pages 프로젝트 페이지는 "/wedding-card/"
VITE_BASE=/
# 배포된 사이트의 절대 URL (랜딩/데모 페이지의 OG 미리보기·캘린더 링크에 사용). 끝에 / 포함. 예: https://our.wedding/
VITE_SITE_URL=
# 플랫폼 API 주소. "/" = 같은 오리진(nginx 가 /api 프록시, 권장), 비우면 데모 전용(청첩장 만들기 불가)
VITE_API_URL=/

# ===== api (청첩장 플랫폼 서버) =====
# 사이트의 공개 주소 (끝에 / 없이). 예: https://our.wedding
# 각 청첩장(/w/<주소>)의 카카오톡 미리보기(og:url, og:image)와 캘린더 링크의 절대 URL 에 쓴다.
# 비우면 요청 헤더(X-Forwarded-Proto/Host)에서 추정한다 — HTTPS 를 앞단 프록시에서 끝내는
# 운영 환경에서는 http:// 로 잡힐 수 있으니 반드시 설정한다.
PUBLIC_ORIGIN=
# 관리 로그인 토큰 서명 키. 비우면 처음 실행할 때 무작위로 만들어 DB 에 보관한다(재시작해도 유지).
# 직접 정하려면 길고 무작위한 값을 넣는다. 예: openssl rand -hex 32
# 값을 바꾸면 발급된 토큰이 모두 무효가 되어 관리자들이 다시 로그인해야 한다.
TOKEN_SECRET=
# 관리 로그인 토큰 유효 시간(시간)
TOKEN_TTL_HOURS=12
# CORS 허용 오리진 (쉼표로 여러 개). 같은 오리진으로만 쓰면 비워둔다.
# GitHub Pages 등 다른 오리진에서 호출하려면 그 오리진을 넣는다. 예: https://haeryangkim.github.io
CORS_ORIGIN=
# 운영자 토큰(선택). 설정하면 Authorization: Bearer <토큰> 으로 "모든" 청첩장에 관리 권한을 가진다
# (신고된 청첩장 삭제, 방명록 글 삭제 등). 길고 무작위한 값 권장. 비우면 기능이 꺼진다.
ADMIN_TOKEN=

# ----- 용량 상한 -----
# 서비스 전체 청첩장 수 (초과 시 새로 만들기 503)
MAX_WEDDINGS=2000
# 청첩장당 방명록 수 (초과 시 409)
MAX_GUESTS=1000
# 서비스 전체 업로드 사진 용량 상한(바이트). 기본 5GB = 5368709120. 초과 시 사진 업로드가 507 로 거절된다.
# 사진은 DB 와 같은 볼륨(/data)에 저장되므로 디스크가 가득 차면 모든 청첩장의 저장이 실패한다
# → 반드시 디스크 여유 공간보다 작게 잡는다.
MAX_UPLOAD_BYTES=5368709120
# 참고) 청첩장당 사진 30장, 장당 2MB, 내용(JSON) 32KB 는 프론트와 공유하는 계약값이라 코드에 고정되어 있다.
#       사진 디스크 사용량은 MAX_UPLOAD_BYTES 를 넘지 않는다(이 상한이 없다면 최악 MAX_WEDDINGS × 30 × 2MB).
#       저장된 청첩장 내용(표지/갤러리)에서 쓰지 않는 업로드는 1시간(PHOTO_ORPHAN_GRACE_MS) 뒤
#       다음 저장/업로드 때 자동으로 정리된다.

# ----- 남용 방지 한도 (WINDOW_MS 동안 MAX 회) -----
# IP별 방명록 등록. 검증을 통과한 등록만 센다.
# 예식장 Wi-Fi·통신사 CGNAT 는 하객 여러 명이 한 IP 를 쓰므로 너무 낮추지 않는다.
RATE_MAX=40
RATE_WINDOW_MS=600000
# 방명록 삭제 비밀번호 실패: (IP, 방명록 항목)별
DELETE_RATE_MAX=5
DELETE_RATE_WINDOW_MS=600000
# IP별 청첩장 만들기 (기본 1시간에 5개)
CREATE_RATE_MAX=5
CREATE_RATE_WINDOW_MS=3600000
# 관리 비밀번호 로그인 실패: (IP, 청첩장)별 (기본 10분에 10회 → 이후 429)
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=600000
# 관리 비밀번호 로그인 실패: 청첩장별(IP 무관). IP 를 바꿔 가며 오는 비밀번호 대입을 묶는다.
# 너무 낮추면 남이 일부러 틀려서 주인의 로그인을 막기 쉬워진다.
LOGIN_SLUG_RATE_MAX=50
LOGIN_SLUG_RATE_WINDOW_MS=600000
# IP별 사진 업로드
PHOTO_RATE_MAX=120
PHOTO_RATE_WINDOW_MS=600000
# IP별 장소 검색
GEOCODE_RATE_MAX=20
GEOCODE_RATE_WINDOW_MS=60000
# 실시간(SSE) 동시 연결 상한: 전체 / IP별. 초과 시 503 → 클라이언트는 폴링으로 동작
SSE_MAX_CLIENTS=500
SSE_MAX_PER_IP=30

# ----- 장소 검색 (주소 → 좌표) -----
# 서버가 대신 호출하는 OpenStreetMap Nominatim search 주소. 자체 Nominatim 을 쓰면 바꾼다.
# 공개 서버는 초당 1회 이하 정책이 있어 서버가 호출 간격(기본 1.1초)을 지키고 결과를 캐시한다.
GEOCODE_URL=https://nominatim.openstreetmap.org/search

# 참고) 아래 값은 docker-compose.yml / 코드 기본값으로 충분해 보통 건드리지 않는다.
#   PORT=8787                     api 내부 포트
#   DB_PATH=/data/guestbook.db    sqlite 파일 (named volume guestbook-data)
#   UPLOAD_DIR=/data/uploads      업로드 사진 폴더 (같은 볼륨 → 볼륨 하나만 백업)
#   INDEX_HTML_URL=http://web/index.html   링크 미리보기용 템플릿을 가져올 곳 (처음 필요할 때 가져와 60초 캐시)
#   INDEX_HTML_PATH=              템플릿을 파일에서 읽을 때 (설정하면 URL 보다 우선; 도커 없이 실행할 때)
#   GEOCODE_USER_AGENT=           Nominatim 에 보내는 User-Agent (기본: 앱 이름만, 개인정보 없음)
#   GEOCODE_MIN_INTERVAL_MS=1100  업스트림 호출 사이 최소 간격
#   BODY_LIMIT=8192 / CONFIG_BODY_LIMIT=65536   JSON 본문 상한 (방명록 등 / 청첩장 내용)
#   TRUST_PROXY=1                 nginx 가 덮어쓴 X-Real-IP / X-Forwarded-* 신뢰.
#                                 이 스택 앞에 호스트 프록시(TLS 종단)를 두면 web/nginx.conf 의
#                                 set_real_ip_from / real_ip_header 주석을 켜야 IP 가 구분된다.
#                                 IP별 한도는 nginx 가 실제 클라이언트 주소를 볼 때만(= rootful Linux Docker +
#                                 IPv4) 방문자를 구분한다. Docker Desktop(macOS/Windows), rootless Docker(기본
#                                 포트 드라이버), IPv6(userland proxy)에서는 모든 방문자가 한 IP(브리지
#                                 게이트웨이)로 보여 한도가 서비스 전체에 걸린다 → README "TRUST_PROXY 주의".
#   PHOTO_ORPHAN_GRACE_MS=3600000 저장된 내용이 쓰지 않는 업로드를 정리하기 전 유예 시간
#   REQUEST_TIMEOUT_MS=60000      요청(헤더+본문) 수신 제한 시간
