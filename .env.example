# docker compose 설정 예시. 이 파일을 .env 로 복사해서 값을 채운다.
#   cp .env.example .env

# ===== web (nginx) =====
# 웹을 노출할 호스트 포트
WEB_PORT=8080

# ----- web 빌드 인자 (이미지 빌드 시점에 Vite 에 주입) -----
# 서빙 하위 경로. 자체 도메인/도커는 "/", GitHub Pages 프로젝트 페이지는 "/wedding-card/"
VITE_BASE=/
# 배포된 청첩장의 절대 URL (OG 미리보기·캘린더 링크에 사용). 끝에 / 포함. 예: https://our.wedding/
VITE_SITE_URL=
# 방명록 API 주소. "/" = 같은 오리진(nginx 가 /api 프록시, 권장), 비우면 데모 모드
VITE_API_URL=/

# ===== api (방명록 서버) =====
# CORS 허용 오리진 (쉼표로 여러 개). 같은 오리진으로만 쓰면 비워둔다.
# GitHub Pages 등 다른 오리진에서 호출하려면 그 오리진을 넣는다. 예: https://haeryangkim.github.io
CORS_ORIGIN=
# 관리자 토큰(선택). 설정하면 DELETE 요청에 Authorization: Bearer <토큰> 으로
# 하객 비밀번호 없이 아무 방명록이나 지울 수 있다. 길고 무작위한 값 권장.
ADMIN_TOKEN=
# 방명록 최대 개수 (초과 시 409)
MAX_GUESTS=1000
# IP별 방명록 등록 한도: RATE_WINDOW_MS(ms) 동안 RATE_MAX 건. 검증을 통과한 등록만 센다.
# 예식장 Wi-Fi·통신사 CGNAT 는 하객 여러 명이 한 IP 를 쓰므로 너무 낮추지 않는다.
RATE_MAX=40
RATE_WINDOW_MS=600000
# 삭제 비밀번호 실패 한도: (IP, 방명록 항목)별로 DELETE_RATE_WINDOW_MS 동안 DELETE_RATE_MAX 회
DELETE_RATE_MAX=5
DELETE_RATE_WINDOW_MS=600000
# 실시간(SSE) 동시 연결 상한: 전체 / IP별. 초과 시 503 → 클라이언트는 폴링으로 동작
SSE_MAX_CLIENTS=500
SSE_MAX_PER_IP=30

# 참고) 아래 값은 docker-compose.yml 에 고정되어 있어 보통 건드리지 않는다.
#   PORT=8787           api 내부 포트
#   DB_PATH=/data/guestbook.db   sqlite 파일 (named volume guestbook-data)
#   TRUST_PROXY=1       nginx 가 덮어쓴 X-Real-IP / X-Forwarded-For 신뢰.
#                       이 스택 앞에 호스트 프록시(TLS 종단)를 두면 web/nginx.conf 의
#                       set_real_ip_from / real_ip_header 주석을 켜야 IP 가 구분된다.
